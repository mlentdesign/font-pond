{
  "name": "font-pairing-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3737",
    "build": "node scripts/build-feel-embeddings.mjs && next build",
    "build:feel": "node scripts/build-feel-embeddings.mjs --force",
    "build:meaning": "node scripts/build-meaning-neighbors.mjs --threshold=0.52 --k=4",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "fontkit": "^2.0.4",
    "opentype.js": "^1.3.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
